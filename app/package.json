{
  "name": "definitely-not-a-console",
  "productName": "Definitely Not a Console",
  "version": "1.5.1",
  "description": "Windows için konsol menülerine (PS5, Xbox 360) benzeyen bir oyun başlatıcı. Resmi değildir.",
  "main": "main.js",
  "author": "Kutay Kılıç <vodkakutay@gmail.com>",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/kutaykilicai/definitely-not-a-console",
  "scripts": {
    "start": "electron .",
    "dist": "node ../tools/build.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.kutaykilicai.definitelynotaconsole",
    "productName": "Definitely Not a Console",
    "copyright": "Copyright (c) 2026 Kutay Kılıç",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**",
      "bin/**",
      "renderer/**",
      "!renderer/sample/**",
      "assets/fonts/**",
      "assets/icons/**"
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "assets/fonts/OFL.txt",
        "to": "LICENSE-NotoSans-OFL.txt"
      }
    ],
    "asar": false,
    "electronDist": "../dist/electron-win",
    "afterPack": "build/afterpack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app.ico",
      "signAndEditExecutable": false,
      "artifactName": "Definitely-Not-a-Console-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Definitely Not a Console",
      "uninstallDisplayName": "Definitely Not a Console",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Definitely Not a Console Setup ${version}.${ext}",
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kutaykilicai/definitely-not-a-console.git"
  }
}
